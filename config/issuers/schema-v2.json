{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EquityLens Issuer Profile v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "company_id", "version", "template", "template_evidence",
    "fiscal_calendar", "metrics", "segments", "cash_debt", "eps_method",
    "eps_method_evidence", "securities", "applicability", "evidence"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "company_id": {"type": "string", "pattern": "^[0-9]{10}$"},
    "version": {"type": "integer", "minimum": 1},
    "template": {"const": "us_gaap_operating_v1"},
    "template_evidence": {"$ref": "#/$defs/evidenceRefs"},
    "fiscal_calendar": {
      "type": "object", "additionalProperties": false,
      "required": ["year_end", "week_based", "evidence"],
      "properties": {
        "year_end": {"type": "string", "pattern": "^[0-9]{2}-[0-9]{2}$"},
        "week_based": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/metric"}},
    "segments": {"$ref": "#/$defs/segments"},
    "cash_debt": {"$ref": "#/$defs/cashDebt"},
    "eps_method": {"type": ["string", "null"], "enum": ["reported_diluted", "two_class", "preferred_adjusted", null]},
    "eps_method_evidence": {"type": "array", "items": {"type": "string"}},
    "securities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/security"}},
    "applicability": {"type": "object"},
    "applicability_evidence": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["concepts", "unit", "context", "period", "selection", "evidence"],
      "properties": {
        "concepts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "unit": {"type": "string"}, "context": {"const": "consolidated"},
        "period": {"enum": ["duration", "instant"]},
        "selection": {"const": "latest_filed_same_basis"},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "member": {
      "type": "object", "additionalProperties": false, "required": ["label"],
      "properties": {"label": {"type": "string"}, "aggregate": {"type": "boolean", "default": false}}
    },
    "axis": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "kind", "label", "members", "evidence"],
      "properties": {
        "name": {"type": "string"}, "kind": {"enum": ["segment", "product", "geo"]},
        "label": {"type": "string"},
        "members": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/member"}},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "segments": {
      "type": "object", "additionalProperties": false,
      "required": ["parser", "axes", "reconciliation", "revenue_concept", "profit_concept", "evidence"],
      "properties": {
        "parser": {"enum": ["ixbrl_segments_v1", "not_applicable"]},
        "axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}},
        "reconciliation": {"enum": ["explicit_eliminations", "not_applicable"]},
        "revenue_concept": {"type": ["string", "null"]}, "profit_concept": {"type": ["string", "null"]},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "cashDebt": {
      "type": "object", "additionalProperties": false,
      "required": ["cash_components", "debt_components", "restricted_cash_policy", "evidence"],
      "properties": {
        "cash_components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "debt_components": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "restricted_cash_policy": {"enum": ["include", "exclude", "separate"]},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "security": {
      "type": "object", "additionalProperties": false,
      "required": ["ticker", "exchange", "currency", "instrument_type", "evidence"],
      "properties": {
        "ticker": {"type": "string"}, "exchange": {"type": "string"}, "currency": {"type": "string"},
        "instrument_type": {"type": "string"}, "class_label": {"type": ["string", "null"]},
        "evidence": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_id", "source_document_id", "content_sha256", "locator"],
      "properties": {
        "evidence_id": {"type": "string"}, "source_document_id": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "locator": {"type": "string", "minLength": 1}
      }
    }
  }
}
